rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each account owns only its own profile and progress.
    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }
    // All other paths are private, including public rankings for now.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
