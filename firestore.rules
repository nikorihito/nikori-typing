rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function own(uid){return signedIn() && request.auth.uid == uid;}
  match /users/{uid} {
   allow read, write: if own(uid);
  }
  // Code documents may only be looked up individually, never listed.
  match /friendCodes/{code} {
   allow get: if signedIn();
   allow list: if false;
   allow create: if signedIn()
     && code.matches('^[A-Z2-9]{12}$')
     && request.resource.data.keys().hasOnly(['uid'])
     && request.resource.data.uid == request.auth.uid;
   allow update, delete: if false;
  }
  // Request IDs are "{recipientUid}_{senderUid}"; the receiver can accept.
  match /friendRequests/{id} {
   allow get: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
   allow list: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
   allow create: if signedIn()
     && request.resource.data.keys().hasOnly(['from','to','status','createdAt'])
     && request.resource.data.from == request.auth.uid
     && request.resource.data.to is string
     && request.resource.data.to != request.auth.uid
     && id == request.resource.data.to + '_' + request.auth.uid
     && request.resource.data.status == 'pending'
     && request.resource.data.createdAt == request.time;
   allow update: if signedIn()
     && resource.data.to == request.auth.uid
     && resource.data.status == 'pending'
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
     && request.resource.data.status in ['accepted','rejected'];
   allow delete: if signedIn() && resource.data.from == request.auth.uid && resource.data.status == 'pending';
  }
  match /{document=**} {allow read, write: if false;}
 }
}